[Unit]
Description=Predict Pulse public dashboard
After=network-online.target predict-pulse.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/predict-pulse
Environment=PREDICT_PULSE_DB=/var/lib/predict-pulse/pulse.sqlite3
ExecStart=/opt/predict-pulse/.venv/bin/gunicorn --workers 3 --threads 2 --bind 127.0.0.1:8091 --access-logfile - --error-logfile - web:app
Restart=on-failure
RestartSec=5
User=predictpulse
Group=predictpulse
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
