[Unit]
Description=Predict Pulse read-only anomaly monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/predict-pulse
Environment=PYTHONPATH=/opt/predict-pulse
ExecStart=/usr/bin/python3 -m predict_pulse.pulse --config /etc/predict-pulse/config.json
Restart=always
RestartSec=10
User=root

[Install]
WantedBy=multi-user.target
