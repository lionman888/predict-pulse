[Unit]
Description=Predict Pulse read-only anomaly monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/predict-pulse
Environment=PYTHONPATH=/opt/predict-pulse
ExecStart=/opt/predict-pulse/.venv/bin/python -m predict_pulse.pulse --config /etc/predict-pulse/config.json
Restart=on-failure
RestartSec=10
User=predictpulse
Group=predictpulse
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/predict-pulse

[Install]
WantedBy=multi-user.target
