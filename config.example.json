{
  "api_key_file": "/etc/predict-pulse/api_key",
  "base_url": "https://api.predict.fun/v1",
  "database": "/var/lib/predict-pulse/pulse.sqlite3",
  "poll_seconds": 60,
  "max_markets": 50,
  "stats_workers": 6,
  "rate_limit_per_minute": 240,
  "retention_days": 30,
  "cooldown_minutes": 20,
  "thresholds": {
    "probability_points_15m": 3.0,
    "probability_points_60m": 6.0,
    "volume24h_delta_usd": 1000,
    "liquidity_change_percent": 30,
    "spread_change_points": 3.0
  },
  "notifications": {
    "console": true,
    "bark": {
      "enabled": false,
      "key_file": "/etc/predict-pulse/bark_key"
    },
    "telegram": {
      "enabled": false,
      "token_file": "/etc/predict-pulse/telegram_token",
      "chat_id": ""
    }
  }
}
